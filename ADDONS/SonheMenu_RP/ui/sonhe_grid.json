{
  "namespace": "sonhe_forms",

  "//": "TILE = copia literal de dois padroes ja dissecados: o icone e o 'image' do vanilla server_form (dynamic_button > panel_name > image, com binding_name_override para #texture e #texture_file_system) e a ancoragem do indice e a do Chest-UI (par '#null' collection + '#null' collection_details NO PROPRIO controle folha, porque icone e label sao IRMAOS do botao, nao filhos dele).",
  "//2": "Nada de binding passado por $variavel, nada de tamanho percentual no item de grid, nada de collection_index, nada de #maximum_grid_items junto de grid_dimensions.",
  "//3": "list_screen (no fim do arquivo) e o fallback com FACTORY em coluna unica, no shape exato do vanilla — usar se o grid nao popular icone/nome.",

  "grid_screen": {
    "type": "panel",
    "size": [ 320, 452 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "grid_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/panel_frame",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      { "grid_content@sonhe_forms.grid_stack": { "layer": 1 } }
    ]
  },

  "grid_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "288px", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 14 ],
    "controls": [
      { "head_title@sonhe_forms.screen_title": {} },
      { "gap_a": { "type": "panel", "size": [ "100%", 6 ] } },
      { "head_body@sonhe_forms.screen_body": {} },
      { "gap_b": { "type": "panel", "size": [ "100%", 8 ] } },
      { "tiles@sonhe_forms.tiles_grid": {} }
    ]
  },

  "screen_title": {
    "type": "label",
    "text": "#title_text",
    "text_alignment": "center",
    "size": [ "100%", "default" ],
    "color": [ 0.22, 0.08, 0.32 ],
    "shadow": false,
    "layer": 3,
    "bindings": [
      { "binding_name": "#title_text", "binding_type": "global" }
    ]
  },

  "screen_body": {
    "type": "label",
    "text": "#form_text",
    "text_alignment": "left",
    "size": [ "100%", "default" ],
    "color": [ 0.30, 0.24, 0.40 ],
    "shadow": false,
    "layer": 3,
    "bindings": [
      { "binding_name": "#form_text" }
    ]
  },

  "tiles_grid": {
    "type": "grid",
    "size": [ "100%", "default" ],
    "offset": [ 0, 0 ],
    "grid_dimensions": [ 3, 4 ],
    "grid_item_template": "sonhe_forms.tile",
    "collection_name": "form_buttons",
    "layer": 1
  },

  "tile": {
    "type": "panel",
    "size": [ 96, 96 ],
    "layer": 1,
    "controls": [
      { "tile_hit@sonhe_forms.tile_button": {} },
      { "tile_icon_bg@sonhe_forms.tile_icon_placeholder": {} },
      { "icon@sonhe_forms.tile_icon": {} },
      { "tile_name@sonhe_forms.tile_label": {} }
    ]
  },

  "tile_button@common.button": {
    "size": [ 88, 88 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 2,
    "$pressed_button_name": "button.form_button_click",
    "bindings": [
      {
        "binding_name": "#null",
        "binding_type": "collection",
        "binding_condition": "none",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#null",
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#null",
        "binding_type": "view",
        "source_property_name": "(not (#form_button_text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "controls": [
      { "default@sonhe_forms.face_default": {} },
      { "hover@sonhe_forms.face_hover": {} },
      { "pressed@sonhe_forms.face_pressed": {} }
    ]
  },

  "face_default": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "fd_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/tile_frame",
          "size": [ "100%", "100%" ],
          "alpha": 1.0,
          "layer": 1
        }
      }
    ]
  },

  "face_hover": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "fh_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/tile_frame",
          "size": [ "100%", "100%" ],
          "alpha": 0.72,
          "layer": 1
        }
      }
    ]
  },

  "face_pressed": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "fp_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/tile_frame",
          "size": [ "100%", "100%" ],
          "alpha": 0.55,
          "layer": 1
        }
      }
    ]
  },

  "tile_icon_placeholder": {
    "type": "image",
    "texture": "textures/ui/sonhe/placeholder",
    "size": [ 32, 32 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 14 ],
    "layer": 3,
    "propagate_alpha": true
  },

  "tile_icon": {
    "type": "image",
    "size": [ 32, 32 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 14 ],
    "layer": 4,
    "propagate_alpha": true,
    "bindings": [
      {
        "binding_name": "#null",
        "binding_type": "collection",
        "binding_condition": "none",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#null",
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
        "target_property_name": "#visible"
      }
    ]
  },

  "tile_label": {
    "type": "label",
    "text": "#form_button_text",
    "size": [ "100% - 8px", "default" ],
    "max_size": [ "100% - 8px", 20 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ 0, -10 ],
    "text_alignment": "center",
    "color": [ 0.20, 0.07, 0.30 ],
    "shadow": false,
    "layer": 4,
    "bindings": [
      {
        "binding_name": "#null",
        "binding_type": "collection",
        "binding_condition": "none",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#null",
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  "//fallback": "=== A PARTIR DAQUI: versao FACTORY (coluna unica), shape literal do vanilla server_form. Trocar em sonhe_forms.json: sonhe_forms.grid_screen -> sonhe_forms.list_screen ===",

  "list_screen": {
    "type": "panel",
    "size": [ 320, 452 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "list_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/panel_frame",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      { "list_content@sonhe_forms.list_stack": { "layer": 1 } }
    ]
  },

  "list_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "288px", "100%c" ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [ 0, 14 ],
    "controls": [
      { "list_title@sonhe_forms.screen_title": {} },
      { "list_gap_a": { "type": "panel", "size": [ "100%", 6 ] } },
      { "list_body@sonhe_forms.screen_body": {} },
      { "list_gap_b": { "type": "panel", "size": [ "100%", 8 ] } },
      { "list_rows@sonhe_forms.buttons_factory": {} }
    ]
  },

  "buttons_factory": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "sonhe_forms.row_button",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "row_button": {
    "type": "stack_panel",
    "size": [ "100%", 32 ],
    "orientation": "horizontal",
    "controls": [
      { "holder@sonhe_forms.row_icon_holder": {} },
      {
        "row_text@common_buttons.light_text_button": {
          "$pressed_button_name": "button.form_button_click",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "fill", 32 ],
          "$button_text": "#form_button_text",
          "$button_text_binding_type": "collection",
          "$button_text_grid_collection_name": "form_buttons",
          "$button_text_max_size": [ "100%", 20 ],
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  "row_icon_holder": {
    "type": "panel",
    "size": [ 34, "100%c" ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "row_icon",
        "resolve_sibling_scope": true,
        "source_property_name": "(not (#texture = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "row_icon": {
          "type": "image",
          "layer": 2,
          "size": [ 32, 32 ],
          "offset": [ 0, 0 ],
          "bindings": [
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  }
}
