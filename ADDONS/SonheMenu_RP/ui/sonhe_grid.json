{
  "namespace": "sonhe_forms",

  "//": "BASE = 1.0.26, estado em que o grid RENDERIZOU 3 por linha e o clique funcionou.",
  "//2": "Unica mudanca sobre essa base: bindings de ancoragem de escopo (#null) no icone e no label.",

  "grid_screen": {
    "type": "panel",
    "size": [320, 452],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "sonhe_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/panel_frame",
          "nineslice_size": [40, 40, 40, 40],
          "size": ["100%", "100%"],
          "layer": 0
        }
      },
      { "sonhe_content@sonhe_forms.content_stack": { "layer": 1 } }
    ]
  },

  "content_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": ["288px", "100%c"],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "offset": [0, 14],
    "controls": [
      {
        "sonhe_title": {
          "type": "label",
          "text": "#title_text",
          "text_alignment": "center",
          "size": ["100%", "default"],
          "color": [0.22, 0.08, 0.32],
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global" }
          ]
        }
      },
      { "gap_title": { "type": "panel", "size": ["100%", 6] } },
      {
        "sonhe_body": {
          "type": "label",
          "text": "#form_text",
          "text_alignment": "left",
          "size": ["100%", "default"],
          "color": [0.30, 0.24, 0.40],
          "bindings": [
            { "binding_name": "#form_text", "binding_type": "global" }
          ]
        }
      },
      { "gap_body": { "type": "panel", "size": ["100%", 8] } },
      { "sonhe_tiles@sonhe_forms.tiles_grid": {} }
    ]
  },

  "tiles_grid": {
    "type": "grid",
    "size": ["100%", "default"],
    "offset": [0, 0],
    "grid_dimensions": [3, 4],
    "grid_item_template": "sonhe_forms.tile",
    "collection_name": "form_buttons",
    "layer": 1
  },

  "tile": {
    "type": "panel",
    "size": [96, 96],
    "layer": 1,
    "controls": [
      {
        "tile_bg": {
          "type": "image",
          "texture": "textures/ui/sonhe/tile_frame",
          "nineslice_size": [24, 24, 24, 24],
          "size": ["100% - 4px", "100% - 4px"],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 1
        }
      },
      {
        "tile_icon": {
          "type": "image",
          "size": [32, 32],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 14],
          "layer": 3,
          "bindings": [
            {
              "binding_name": "#null",
              "binding_type": "collection",
              "binding_condition": "none",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#null",
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture",
              "binding_name_override": "#texture",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_texture_file_system",
              "binding_name_override": "#texture_file_system",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "tile_label": {
          "type": "label",
          "text": "#form_button_text",
          "size": ["100% - 10px", "default"],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [0, -10],
          "text_alignment": "center",
          "color": [0.20, 0.07, 0.30],
          "layer": 3,
          "bindings": [
            {
              "binding_name": "#null",
              "binding_type": "collection",
              "binding_condition": "none",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#null",
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      },
      {
        "tile_button@common_buttons.light_text_button": {
          "size": ["100% - 4px", "100% - 4px"],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": 2,
          "$button_text": "",
          "$button_pressed_offset": [0, 0],
          "$pressed_button_name": "button.form_button_click",
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  }
}
